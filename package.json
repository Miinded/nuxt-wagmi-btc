{
  "name": "@miinded/nuxt-wagmi-btc",
  "version": "2.0.0",
  "description": "Nuxt module that connects Bitcoin wallets (Xverse, Leather, Magic Eden, Phantom, Unisat) behind one wagmi-like API: addresses, message and PSBT signing, BTC transfers.",
  "license": "MIT",
  "author": "Starker-xp <starker-xp@miinded.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miinded/nuxt-wagmi-btc.git"
  },
  "bugs": {
    "url": "https://github.com/Miinded/nuxt-wagmi-btc/issues"
  },
  "homepage": "https://github.com/Miinded/nuxt-wagmi-btc#readme",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "bitcoin",
    "wallet",
    "ordinals",
    "psbt",
    "xverse",
    "leather",
    "magic-eden",
    "phantom",
    "unisat",
    "wagmi"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "format": "prettier --config .prettierrc.json --write .",
    "format:check": "prettier --config .prettierrc.json --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc -b --noEmit",
    "commitlint": "commitlint",
    "deps:check": "node ./config/check-dependency-policy.mjs",
    "ci:quality": "pnpm deps:check && pnpm dev:prepare && pnpm lint && pnpm test:types && pnpm test:coverage && pnpm build",
    "release": "pnpm ci:quality && changeset version && changeset publish"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,vue,json,md,yml,yaml}": "prettier --config .prettierrc.json --write --ignore-unknown"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "bitcoinjs-lib": "^6.1.9",
    "jsontokens": "^4.0.1",
    "sats-connect": "^3.6.1",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nuxt/devtools": "^2.7.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^3.23.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nuxt": "^4.6.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  }
}
